/// A user-created spending category, offered alongside the application's predefined ones.
model CustomCategory {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Display name; unique per user, case-insensitively (citext compares
  /// case-insensitively, so the DB backs the API's insensitive conflict check).
  label       String       @db.Citext
  /// Palette color name, validated against CATEGORY_COLOR_VALUES.
  color       String
  /// Icon name, validated against CATEGORY_ICON_NAMES.
  icon        String
  /// Category group slug this one nests under; null = it is a group of its own.
  parentSlug  String?
  /// Position among the user's custom categories sharing the same parent.
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  budgetLines BudgetLine[]

  @@unique([userId, label])
  @@index([userId, parentSlug, sortOrder])
  @@map("custom_category")
}

/// One declared monthly amount. A user's budget lines are their budgeting
/// profile; there is no separate profile row because nothing hangs off one.
/// A line declares a category and nothing else: where it sits in the
/// revenues → investments → outgoings flow is derived from that category's
/// group (see `budgetLineKindOf`), so the two can never disagree.
model BudgetLine {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Display name, e.g. "Rent"; null when the user gave none, and the
  /// category's own name stands in at display time.
  label        String?
  /// Planned amount per month in minor units; always positive.
  amount       Int
  /// Predefined category slug (a leaf of the hierarchy, never a group);
  /// null when categoryId is set.
  categorySlug String?
  /// Custom category; null when categorySlug is set. Restrict is safe because
  /// deleteCustomCategory reassigns referencing lines before deleting.
  categoryId   String?
  category     CustomCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Position within the profile.
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, sortOrder])
  @@index([categoryId])
  @@map("budget_line")
}
