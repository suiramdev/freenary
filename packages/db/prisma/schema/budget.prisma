/// A link to an external banking provider (e.g. Enable Banking).
/// Hierarchy: User → BankConnection → BankAccount → Transaction.
model BankConnection {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Provider identifier (e.g. "enable-banking").
  provider          String
  /// Provider-level session identifier used to refresh data.
  providerSessionId String
  /// Human-readable institution name shown in the UI.
  institutionName   String
  /// ISO 3166-1 alpha-2 country code of the institution (e.g. "FR", "DE").
  institutionCountry String?
  /// SWIFT/BIC of the institution when available from the provider.
  institutionBic    String?
  /// Banking group identifier from the provider (e.g. "Credit Agricole" for regional caisses).
  institutionGroup  String?
  /// Status of the connection — active connections can sync transactions.
  status            BankConnectionStatus @default(ACTIVE)
  /// Last time transactions were successfully synchronized.
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  accounts          BankAccount[]

  @@index([userId])
  @@map("bank_connection")
}

enum BankConnectionStatus {
  ACTIVE
  EXPIRED
  ERROR
}

/// An individual bank account within a connection.
model BankAccount {
  id                 String         @id @default(cuid())
  connectionId       String
  connection         BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Provider-level unique identifier for the account.
  providerAccountId  String
  /// IBAN when available (EU accounts).
  iban               String?
  /// Provider-assigned opaque account hash for cross-account matching.
  identificationHash String?
  name               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  transactions       Transaction[]

  @@unique([connectionId, providerAccountId])
  @@index([connectionId])
  @@map("bank_account")
}

/// A single financial transaction (purchase, sale, deposit, withdrawal, etc.).
model Transaction {
  id                String      @id @default(cuid())
  accountId         String
  account           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Provider-level transaction identifier for deduplication.
  providerTransactionId String?
  /// Booking date of the transaction.
  date              DateTime
  /// Signed amount in minor units (negative = outgoing, positive = incoming).
  amount            Int
  /// ISO 4217 currency code (e.g. "EUR", "USD").
  currency          String
  /// Transaction description / narrative from the bank.
  description       String      @default("")
  /// Counterparty name when available.
  counterpartyName  String?
  /// ISO 18245 merchant category code (e.g. "5411" for grocery stores).
  merchantCategoryCode  String?
  /// Bank's own transaction classification description.
  bankTransactionCode   String?
  /// Bank's transaction sub-code.
  bankTransactionSubCode String?
  /// Transaction status: BOOK (default), PDNG, HOLD, SCHD, RJCT, OTHR.
  status                String      @default("BOOK")
  /// Value date — when funds become available.
  valueDate             DateTime?
  /// Transaction date — card swipe or transfer acquisition date.
  transactionDate       DateTime?
  /// Balance in minor units after this transaction.
  balanceAfterTransaction Int?
  /// Creditor (receiver) IBAN when available.
  creditorAccountIban   String?
  /// Debtor (sender) IBAN when available.
  debtorAccountIban     String?
  /// Structured creditor reference number.
  referenceNumber       String?
  /// Foreign exchange rate as a string.
  exchangeRate          String?
  /// User-selected category; null = use automatic resolution.
  category              String?
  /// True only when this transaction was edited directly by the user.
  categoryOverride      Boolean     @default(false)
  /// Category produced by the categorisation pipeline.
  resolvedCategory      String?
  /// Canonical normalised descriptor for card-path transactions.
  normalisedDescriptor String?
  /// Derived lookup key: creditor IBAN for IBAN-path, normalised label for card-path.
  merchantKey          String?
  /// Raw remittance lines as provided by the bank; order is not guaranteed.
  remittanceLines      String[]
  /// ISO 20022 family code for the transaction; the domain is not exposed upstream.
  bankTransactionFamilyCode String?
  /// Creditor agent BIC — identifies the acquiring bank.
  creditorAgentBic     String?
  /// Creditor town from the postal address; weak geographic signal.
  creditorTown         String?
  /// Creditor country, ISO 3166 alpha-2.
  creditorCountry      String?
  /// Extra creditor identifiers from the provider (SIREN/SIRET/CPAN...).
  creditorIdentifications Json?
  /// Scheme of referenceNumber when the provider reports it.
  referenceNumberScheme String?
  /// The account holder's own note, where the bank exposes it.
  psuNote              String?
  /// Detected payment intermediary name; null when no intermediary.
  intermediaryName     String?
  /// Detected transaction channel: card, transfer, direct-debit, atm, fee, cheque, loan, unknown.
  channel              String?
  /// Transaction path: "iban" (direct debits, transfers) or "card".
  transactionPath      String?
  /// Pipeline stage that produced the resolution.
  resolutionStage      String?
  /// Confidence of the resolution in the range 0..1.
  resolutionConfidence Float?
  /// True when this transaction is one leg of a movement between the user's own accounts.
  isInternalTransfer   Boolean     @default(false)
  createdAt         DateTime    @default(now())

  @@unique([accountId, providerTransactionId])
  @@index([accountId, date])
  @@index([accountId, amount])
  @@index([merchantKey])
  @@map("transaction")
}

/// A user's category override for a merchant key. The user wins over every
/// other layer permanently, with no reconciliation prompt.
model MerchantOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lookup key: creditor IBAN or normalised descriptor.
  merchantKey String
  /// The category the user assigned.
  category    String
  /// User-friendly merchant name when known.
  merchantName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("merchant_override")
}
