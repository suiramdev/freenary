/// A canonical merchant, seeded from the embedded dictionary or learned from user data.
model Merchant {
  id             String   @id
  name           String
  /// normaliseDescriptor(name) — the trigram match key.
  normalisedName String
  /// Default spending category; null when the source carries no category signal.
  category       String?
  /// Known web domains, used for domain-token matching.
  domains        String[]
  /// Provenance: "nsi" | "wikidata" | "user" | "seed".
  source         String
  createdAt      DateTime @default(now())
  aliases        MerchantAlias[]
  memos          DescriptorMemo[]
  transactions   Transaction[]

  @@index([normalisedName])
  /// GiST is required for the `<->` KNN operator used by candidate generation.
  @@index([normalisedName(ops: raw("gist_trgm_ops"))], type: Gist, name: "merchant_normalisedName_trgm_idx")
  @@map("merchant")
}

/// An alternative spelling for a merchant (brand alias, trade name, abbreviation).
model MerchantAlias {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  alias           String
  /// normaliseDescriptor(alias) — the trigram match key.
  normalisedAlias String

  @@unique([merchantId, normalisedAlias])
  @@index([normalisedAlias])
  /// GiST is required for the `<->` KNN operator used by candidate generation.
  @@index([normalisedAlias(ops: raw("gist_trgm_ops"))], type: Gist, name: "merchant_alias_normalisedAlias_trgm_idx")
  @@map("merchant_alias")
}

/// A payment intermediary (PSP/acquirer) whose descriptor can mask the real merchant.
model Intermediary {
  id           String   @id
  name         String
  /// Creditor IBANs observed for this intermediary.
  ibans        String[]
  memos        DescriptorMemo[]
  transactions Transaction[]

  @@map("intermediary")
}

/// Learned descriptor -> merchant/category. userId null = global knowledge.
model DescriptorMemo {
  id                   String        @id @default(cuid())
  /// Null = global entry shared by every user; non-null = one user's override.
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalisedDescriptor String
  merchantId           String?
  merchant             Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  intermediaryId       String?
  intermediary         Intermediary? @relation(fields: [intermediaryId], references: [id], onDelete: SetNull)
  category             String?
  /// Times this memo matched; drives confidence and pruning.
  hitCount             Int           @default(1)
  /// "user-correction" | "resolver" | "seed".
  source               String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([userId, normalisedDescriptor])
  @@index([normalisedDescriptor])
  @@map("descriptor_memo")
}
