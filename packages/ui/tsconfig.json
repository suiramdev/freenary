{
  "extends": "@freenary/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "paths": {
      "@freenary/ui/*": ["./src/*"]
    },
    "strictNullChecks": true,
    // Fluid Functionalism registry sources are vendored as-is and predate
    // this flag; keep them un-forked.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Tests run under Bun and need its ambient types, which `types: []` keeps out
  // of the component sources; tsconfig.test.json checks them separately.
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
