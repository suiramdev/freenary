{
  "name": "@freenary/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build:data": "bun scripts/download-data.ts || bun run build:data:generate",
    "build:data:generate": "bun scripts/generate-place-tokens.ts && bun scripts/fetch-wikidata-brands.ts && bun scripts/build-merchant-dictionary.ts",
    "build:places": "bun scripts/generate-place-tokens.ts",
    "generate:key": "bun scripts/generate-signing-key.ts",
    "train:model": "bun scripts/train-model.ts"
  },
  "dependencies": {
    "@freenary/auth": "workspace:*",
    "@freenary/db": "workspace:*",
    "@freenary/env": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "dotenv": "catalog:",
    "fflate": "^0.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@freenary/config": "workspace:*",
    "elysia": "catalog:",
    "typescript": "catalog:"
  }
}
