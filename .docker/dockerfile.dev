FROM oven/bun:1-slim

WORKDIR /app

COPY package.json bun.lock tsconfig.json turbo.json ./

COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
COPY apps/fumadocs/package.json ./apps/fumadocs/

COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/
COPY packages/config/tsconfig.base.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/env/package.json ./packages/env/
COPY packages/ui/package.json ./packages/ui/

RUN bun install --frozen-lockfile --ignore-scripts

# Source baked in (watch syncs changes on top); node_modules excluded via .dockerignore
COPY . .
