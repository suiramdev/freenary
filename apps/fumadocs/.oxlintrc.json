{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../node_modules/@jliocsar/begone-slop/preset.json"],
  "jsPlugins": ["@jliocsar/begone-slop"],
  "plugins": ["typescript", "react", "import"],
  "categories": {},
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "tailwindcss": {
      "callees": ["cva", "cn"]
    }
  },
  "ignorePatterns": ["node_modules/", "dist/"]
}
