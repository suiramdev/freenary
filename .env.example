
POSTGRES_DB=freenary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=dev_secret_change_me_at_least_32chars

# OrbStack domains — override to run multiple worktrees in parallel. The compose
# file defaults are server.freenary.orb.local / web.freenary.orb.local /
# docs.freenary.orb.local, so leaving these unset is fine for a single checkout.
# SERVER_HOST=server.freenary.orb.local
# WEB_HOST=web.freenary.orb.local
# DOCS_HOST=docs.freenary.orb.local

# Bank provider — "powens" (default, recommended) or "enable-banking".
# BANKING_PROVIDER=powens

# Powens — optional. Leave unset (with no other provider) to skip the bank-connection onboarding step.
# Create a domain and a client application at https://console.powens.com, whitelist
# https://<web origin>/callback/powens as a redirect URL of that client, and ask Powens to
# activate Wealth & Loans if you want investment accounts and holdings.
# POWENS_DOMAIN=acme-sandbox
# POWENS_CLIENT_ID=12345678
# POWENS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Enable Banking — optional alternative provider; requires BANKING_PROVIDER=enable-banking.
# Sign up at https://enablebanking.com/sign-in/, register an app in the Control Panel,
# and download the private key .pem file.
# ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----"

# Dictionary signature verification — optional. Set to the Ed25519 public key
# PEM output from: bun run generate:key
# DICTIONARY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----"
