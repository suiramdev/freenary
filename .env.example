
POSTGRES_DB=freenary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=dev_secret_change_me_at_least_32chars

# OrbStack domains — override to run multiple worktrees in parallel. The compose
# file defaults are server.freenary.orb.local / web.freenary.orb.local /
# docs.freenary.orb.local, so leaving these unset is fine for a single checkout.
# SERVER_HOST=server.freenary.orb.local
# WEB_HOST=web.freenary.orb.local
# DOCS_HOST=docs.freenary.orb.local

# Email delivery — required for one-time codes, email verification and password
# reset. `log` prints codes to the server log and is refused in production;
# compose.dev.yml already defaults to it, so the OTP flows work with no mail
# account. Pick `resend` or `smtp` for a real deployment.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM="Freenary <no-reply@example.com>"
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=...

# Sign-in providers — each optional and inert while unset, so a deployment that
# configures none of them shows none of the buttons.
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/google
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Apple: https://developer.apple.com/account/resources/identifiers
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/apple
# APPLE_CLIENT_ID=com.example.freenary
# APPLE_CLIENT_SECRET=...
# APPLE_APP_BUNDLE_IDENTIFIER=com.example.freenary
# Any OpenID Connect provider (Authentik, Keycloak, Zitadel, Entra, …).
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/oidc
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_PROVIDER_NAME="Example SSO"
# OIDC_SCOPES=groups

# Check new passwords against Have I Been Pwned (a SHA-1 prefix leaves the
# server). Turn off for an air-gapped deployment.
# AUTH_PASSWORD_BREACH_CHECK=true

# Parent domain the API and the web app share, e.g. ".example.com". Set it when
# they sit on different subdomains: it keeps the session cookie SameSite=Lax
# instead of dropping to None.
# AUTH_COOKIE_DOMAIN=.example.com

# Reverse proxies in front of the server, as addresses or CIDR ranges. Rate
# limits key on the caller's address, and without this a multi-hop
# X-Forwarded-For is refused and every caller shares one bucket.
# TRUSTED_PROXIES=10.0.0.0/24,192.0.2.10

# Bank provider — "powens" (default, recommended) or "enable-banking".
# BANKING_PROVIDER=powens

# Powens — optional. Leave unset (with no other provider) to skip the bank-connection onboarding step.
# Create a domain and a client application at https://console.powens.com, whitelist
# https://<web origin>/callback/powens as a redirect URL of that client, and ask Powens to
# activate Wealth & Loans if you want investment accounts and holdings.
# POWENS_DOMAIN=acme-sandbox
# POWENS_CLIENT_ID=12345678
# POWENS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Enable Banking — optional alternative provider; requires BANKING_PROVIDER=enable-banking.
# Sign up at https://enablebanking.com/sign-in/, register an app in the Control Panel,
# and download the private key .pem file.
# ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----"

# Dictionary signature verification — optional. Set to the Ed25519 public key
# PEM output from: bun run generate:key
# DICTIONARY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----"
