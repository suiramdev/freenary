
POSTGRES_DB=freenary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

BETTER_AUTH_SECRET=dev_secret_change_me_at_least_32chars

# OrbStack domains — override to run multiple worktrees in parallel. The compose
# file defaults are server.freenary.orb.local / web.freenary.orb.local /
# docs.freenary.orb.local, so leaving these unset is fine for a single checkout.
# SERVER_HOST=server.freenary.orb.local
# WEB_HOST=web.freenary.orb.local
# DOCS_HOST=docs.freenary.orb.local

# Enable Banking — optional. Leave unset to skip the bank-connection onboarding step.
# Sign up at https://enablebanking.com/sign-in/, register an app in the Control Panel,
# and download the private key .pem file.
# ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----"

# Optional merchant enrichment through recherche-entreprises.api.gouv.fr.
# A sync request must also explicitly permit external categorisation.
# SIRENE_LOOKUP_ENABLED=false

# Place-token generation — controls which countries' cities are included in the
# place-token dictionary used to strip location noise from bank descriptors.
# Both are optional and only affect `bun run build:data` / `bun run build:places`.
#
# Whitelist: replaces the built-in default country set entirely.
# FREENARY_PLACE_COUNTRIES=FR,DE,ES,IT
#
# Blacklist: removes specific countries from the active set.
# FREENARY_PLACE_COUNTRIES_EXCLUDE=HR,RO
